# Vorlage für .env.security.local (die .local-Datei wird NICHT eingecheckt).
# Für scripts/security/attack-test.mjs (Testkonten A, B) und deletion-test.mjs (Testkonto C).
# Ausschließlich Testkonten, keine echten Nutzer.
SUPABASE_URL=
SUPABASE_ANON_KEY=
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
# Löschtest: für JEDEN Lauf ein frisch registriertes Konto (wird gelöscht), nie A oder B
TEST_C_EMAIL=
TEST_C_PASSWORD=
