{
  "name": "friedensstifter-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/security/check-build.mjs && node scripts/security/check-content.mjs && node scripts/security/check-sw.mjs",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "security:test": "node --env-file=.env.security.local scripts/security/attack-test.mjs",
    "security:deletion-test": "node --env-file=.env.security.local scripts/security/deletion-test.mjs",
    "pwa:icons": "node scripts/pwa/build-icons.mjs",
    "security:k7": "node --env-file=.env.security.local scripts/security/k7-signup-test.mjs",
    "security:secrets": "node scripts/security/secret-scan.mjs",
    "share:zip": "node scripts/share-zip.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.445.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "0.2.6",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "opentype.js": "1.3.4",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.12",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
